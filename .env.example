# Zugangsdaten für den Betrieb auf einem eigenen Rechner.
# Nach .env kopieren und ausfüllen. Die Datei .env wird nicht ins Repository übernommen.
# Bei GitHub Actions kommen dieselben Namen als Secrets in die Einstellungen des Repositorys.

# Push über ntfy: Thema (langer Zufallsname, wirkt wie ein Passwort)
NTFY_TOPIC=
# NTFY_TOKEN=
# NTFY_SERVER=https://ntfy.sh

# E-Mail: schaltet sich ein, sobald SMTP_HOST und MAIL_TO gesetzt sind
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_TO=
# MAIL_FROM=

# Adresse des Lageberichts, die in den Meldungen verlinkt wird
# STATUS_URL=
